# ==========================================================
# quant_iTransformer 环境变量配置
# ⚠️ 本文件包含实盘 API 密钥，已被 .gitignore 排除，切勿提交到仓库！
# 所有模块通过 python-dotenv 的 load_dotenv() 读取本文件。
# ==========================================================

# ------------------------------------------------------------
# 1. 外部服务密钥 (必填：请替换为你自己的真实密钥)
# ------------------------------------------------------------

# Gate.io 模拟盘 (Sandbox) API 密钥 —— execution_oms.py / risk_manager.py
# 申请地址: https://www.gate.io/zh/apiv2 (开启"交易+合约"权限，绑定服务器 IP)
GATE_DEMO_API_KEY=your_gate_sandbox_key
GATE_DEMO_SECRET=your_gate_sandbox_secret

# PushPlus 微信推送 token —— execution_oms.py / risk_manager.py (开仓/平仓/风控警报)
# 申请地址: https://www.pushplus.plus
PUSHPLUS_TOKEN=your_pushplus_token

# DeepSeek API key —— sentiment_scraper.py (宏观情绪哨兵)
# 留空时情绪裁判自动休眠，实盘按中性得分 0.0 处理
DEEPSEEK_API_KEY=your_deepseek_key

# ------------------------------------------------------------
# 2. DeepSeek 宏观裁判调参 (有默认值，按需修改)
# ------------------------------------------------------------
DEEPSEEK_CONNECT_TIMEOUT=10
DEEPSEEK_READ_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_THINKING_MODE=disabled

# ------------------------------------------------------------
# 3. 实盘安全开关 (quant_config/config.py)
# ------------------------------------------------------------
# 交易模式: sandbox = Gate.io 模拟盘 (默认，强烈建议) | live = 真实资金
GATE_TRADING_MODE=sandbox

# 真实资金二次确认：只有 GATE_TRADING_MODE=live 且本项等于 I_UNDERSTAND_REAL_MONEY
# 时才会关闭 ccxt sandbox 并允许真实下单。模拟盘阶段保持为空即可。
LIVE_TRADING_ENABLED=

# 开仓前强制校验逐仓模式 (true/false)，无法确认逐仓时拒绝开新仓
GATE_REQUIRE_ISOLATED_MARGIN=true

# ------------------------------------------------------------
# 4. 小账户硬风控闸 (live 模式下必须配置为正数，否则 OMS 拒绝开仓)
#    sandbox 模式下保持默认 0 即可跳过真实余额校验
# ------------------------------------------------------------
# 单笔最大保证金 (USDT)
MAX_MARGIN_PER_TRADE_USDT=0.0
# 单笔占用可用余额的最大比例 (live 必须 > 0)
MAX_BALANCE_RISK_PCT=0.20
# 下单后必须保留的最低可用 USDT
MIN_FREE_USDT_AFTER_ORDER=0.0
# UTC 自然日日内亏损熔断线 (USDT，live 必须 > 0)
DAILY_MAX_LOSS_USDT=0.0

# ------------------------------------------------------------
# 5. 右脑风控快照参数
# ------------------------------------------------------------
# 右脑向本地行情网关请求快照的超时秒数
RIGHT_BRAIN_SNAPSHOT_TIMEOUT=3.0
# 右脑快照缺失告警冷却 (秒)
RIGHT_BRAIN_SNAPSHOT_WARN_COOLDOWN=60.0

# ==========================================================
# 6. OPT_* 实验参数覆盖区 (全部可选，不写则使用 config.py 内置默认值)
#    训练/回测时也可用命令行临时覆盖，例如:
#    OPT_EXP_ID=EXP_TEST_001 OPT_D_MODEL=128 python3 historical_pipeline/train_itransformer.py
# ==========================================================

# --- 实验与模型结构 ---
#OPT_EXP_ID=default_run            # 实验 ID，决定模型权重/阈值文件名
#OPT_FORECAST_HORIZON=12           # 预测未来 N 小时收益
#OPT_SEQ_LEN=672                   # 输入时间窗口长度
#OPT_BATCH_SIZE=128                # 训练 batch size
#OPT_EPOCHS=100                    # 最大训练轮数
#OPT_LEARNING_RATE=5e-6            # AdamW 学习率
#OPT_D_MODEL=64                    # Transformer 隐层维度
#OPT_E_LAYERS=1                    # Encoder 层数
#OPT_DROPOUT=0.3                   # Dropout
#OPT_CLASS_THRESHOLD=0.035         # 未来收益三分类阈值

# --- 回测与交易参数 ---
#OPT_LEVERAGE_1=2.0                # Tier 1 (top_10) 杠杆
#OPT_LEVERAGE_2=5.0                # Tier 2 (top_5) 杠杆
#OPT_LEVERAGE_3=8.0                # Tier 3 (top_1) 杠杆
#OPT_HOLD_PERIOD=12                # 最大持仓小时数
#OPT_HOLD_EXPIRY_GRACE_SECONDS=60  # 持仓到期容差秒数
#OPT_HARD_TP=0.02                  # 宽松追踪止盈启动线 (K线物理幅度)
#OPT_HARD_SL=0.025                 # 固定止损 (K线物理幅度)
#OPT_TRAILING_ATR_PERIOD=14        # 追踪止盈 ATR 周期 (1m K线)
#OPT_TRAILING_ATR_MULTI=3.5        # 追踪止盈 ATR 倍数
#OPT_TRAILING_PHYSICAL_GAP=0.015   # 宽松追踪中物理棘轮与最高浮盈的距离

# --- 宏观情绪 Logit 融合曲线 ---
#OPT_MACRO_LOGIT_DEAD_ZONE=0.20    # 情绪死区 (|score| 低于此值不调整)
#OPT_MACRO_LOGIT_MID_SCORE=0.50    # 中段情绪锚点
#OPT_MACRO_LOGIT_TAIL_SCORE=0.80   # 尾部情绪锚点
#OPT_MACRO_LOGIT_MID_DELTA=0.075   # 中段最大 logit 调整
#OPT_MACRO_LOGIT_TAIL_DELTA=0.420  # 尾部最大 logit 调整
#OPT_MACRO_LOGIT_MAX_DELTA=0.550   # |score|=1 时的最大 logit 调整
#OPT_MACRO_MAX_PROB_SHIFT=0.05     # 最终概率位移硬上限 (5 个百分点)
#OPT_MACRO_LOGIT_MID_POWER=1.35    # 中段曲线幂次
#OPT_MACRO_LOGIT_TAIL_POWER=3.0    # 尾部曲线幂次
#OPT_MACRO_LOGIT_EXTREME_POWER=1.5 # 极端区曲线幂次
